#!/usr/bin/make -f
# The drop-ins are installed to /usr/share (dpkg-managed) and copied into
# /etc/systemd/system/*.service.d/ by the maintainer scripts, so they are never
# treated as conffiles and removal ordering stays correct (loaders removed before
# the module they name). No compiled artifacts — pure Perl + config.

%:
	dh $@

# dh_fixperms resets files under /usr/lib to 0644; the daemon-start wrapper must be
# executable (systemd ExecStart runs it directly). Restore its mode after fixperms.
override_dh_fixperms:
	dh_fixperms
	chmod 0755 debian/pve-csi-copy/usr/lib/pve-csi-copy/pve-csi-copy-exec
